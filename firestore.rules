rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in person can read and write only their own tracker.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Admins: the founders, plus co-hosts the founders add (config/admins.emails). Keep FOUNDERS in index.html in step.
    function isAdmin() {
      return request.auth != null && request.auth.token.email_verified == true && (
        request.auth.token.email.lower() in ['dinduking1@gmail.com', 'chimdindu@empirewords.com'] ||
        (exists(/databases/$(database)/documents/config/admins) &&
         request.auth.token.email.lower() in get(/databases/$(database)/documents/config/admins).data.emails));
    }

    // Programs the hosts publish (e.g. 75 Hard): every signed-in member reads them; only admins write.
    match /programs/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /config/admins {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Crews: anyone signed in can look up a crew by its code (to join) or create one.
    match /groups/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.owner == request.auth.uid;

      function isMember() {
        return exists(/databases/$(database)/documents/groups/$(code)/members/$(request.auth.uid));
      }

      // The leaderboard: members see each other; each person writes only their own row.
      match /members/{uid} {
        allow read: if request.auth != null && isMember();
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      // The activity feed: members read it; each person posts only as themselves; nobody edits history.
      match /events/{id} {
        allow read: if request.auth != null && isMember();
        allow create: if request.auth != null && isMember() && request.resource.data.uid == request.auth.uid;
        allow update, delete: if false;
      }

      // Crew chat: members read it; each person posts only as themselves (text up to 1000 characters) and can delete their own.
      match /messages/{id} {
        allow read: if request.auth != null && isMember();
        allow create: if request.auth != null && isMember() && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000;
        allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
        allow update: if false;
      }

      // Push tokens for crew alerts: each person manages only their own.
      match /devices/{uid} {
        allow read: if request.auth != null && isMember();
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
